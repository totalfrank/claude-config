{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__Notion",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",

      "Bash(go test:*)",
      "Bash(pytest:*)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(make test:*)"
    ],
    "deny": [
      "mcp__Notion__notion-delete-pages",
      "mcp__Notion__notion-delete-databases",
      "mcp__Notion__notion-delete-comment",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/secrets/**)"
    ]
  }
}
